# Go build / module caches (relocated into the repo in this sandbox)
/.gocache/

# Docker CLI and buildx state, including `docker login` credentials
/.docker/

# Local runtime data: registry storage
/data/
/bin/
coverage.out
*.log

# Scratch space for local probes and live acceptance runs. It accumulates
# copies of deployment artifacts — including htpasswd files and host configs —
# and must never be committed.
/.probe/

# Local overrides
.env
.env.local
/config/htpasswd.local

# Editor / OS
.idea/
.vscode/
*.swp
.DS_Store
