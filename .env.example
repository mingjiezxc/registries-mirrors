# Copy to .env and adjust. docker compose reads this file automatically.
#
# Which values you need depends on the host rms runs on. Measured from this
# environment:
#
#   host                       public registries            10.82.64.172 mirrors
#   192.168.188.101 (dev)      only via http://192.168.188.1:3128    reachable
#   192.168.188.103 (public)   directly                      unreachable
#
# So on .101 keep the proxy block below; on .103 set RMS_UPSTREAM_PROXY to the
# literal "direct" ... in practice leave it empty and unset HTTP_PROXY.

# --- image / ports -----------------------------------------------------------
# Two ports only. There is no per-namespace port any more: the old scheme bound
# one port per upstream (docker.io, ghcr.io, ...) and was removed together with
# the `listeners` config block it needed. Unqualified requests now pick their
# namespace inside rms — see the README section on why the per-upstream ports
# were removed, and what that costs clients that can only take a bare host:port.
RMS_IMAGE=rms:dev
RMS_PORT_PRIMARY=5000
RMS_PORT_METRICS=9100

# --- storage / configuration -------------------------------------------------
# Host directory holding the per-namespace caches. Must be writable by uid 65532
# inside the container: `make prepare` creates and chowns it.
RMS_DATA_DIR=./data

# The config directory is mounted as a whole; see the comment in
# docker-compose.yml for why it is not mounted file by file.

# Origin clients use for the primary listener. Empty means "derive from the
# request", which is correct when rms is reached directly. Set it to
# https://rms.watsons.eu.org when a TLS terminator sits in front, otherwise the
# upload URLs rms returns would say http and pushes would fail.
RMS_EXTERNAL_URL=

# Upload-state secret. Leave empty to let rms derive a stable value; set a random
# string to control it (for example `openssl rand -hex 32`).
RMS_HTTP_SECRET=

# --- outbound proxy ----------------------------------------------------------
# Proxy used for upstream registries. Empty falls back to HTTP_PROXY/HTTPS_PROXY.
RMS_UPSTREAM_PROXY=
RMS_NO_PROXY=

# Used both at image build time (module downloads) and at run time.
HTTP_PROXY=http://192.168.188.1:3128
HTTPS_PROXY=http://192.168.188.1:3128
# Loopback, the LAN, and the SASE-reachable corporate ranges must never be
# proxied: the chain to an internal mirror like 10.82.64.172 depends on it.
NO_PROXY=localhost,127.0.0.1,192.168.188.0/24,10.82.0.0/16,10.44.0.0/16
