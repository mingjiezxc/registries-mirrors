# containerd / k3s registry mirror configuration for rms.
#
# K3s:        /etc/rancher/k3s/registries.yaml   then `systemctl restart k3s`
# containerd: /etc/containerd/certs.d/<host>/hosts.toml (see the hosts.toml
#             variant at the bottom), or the deprecated `registry.mirrors` block.
#
# WHY THE MIRROR CANNOT CARRY A PATH
# ----------------------------------
# containerd builds a mirror request from the endpoint as follows
# (core/remotes/docker/config/hosts.go):
#
#     if len(u.Path) > 0 {
#         u.Path = path.Clean(u.Path)
#         if !strings.HasSuffix(u.Path, "/v2") && !config.OverridePath {
#             u.Path = u.Path + "/v2"          # path lands BEFORE /v2
#         }
#     } else if !config.OverridePath {
#         u.Path = "/v2"
#     }
#
# so "http://host/docker.io" would be requested as "/docker.io/v2/<repo>" rather
# than "/v2/docker.io/<repo>", and `registries.yaml` has no override_path field
# to change that. Docker's daemon.json is stricter still: a path in
# registry-mirrors is rejected outright by ValidateMirror, and registry-mirrors
# only ever applies to Docker Hub.
#
# This is why the mirror endpoint below is a bare host:port with no path — rms
# resolves the namespace itself. Point every Hub mirror at the PRIMARY endpoint:
#
#     docker.io/library/alpine  ->  http://192.168.188.101:5000/v2/library/alpine/...
#
# rms then probes every proxy namespace concurrently and serves the request from
# the fastest one that really has that repository (namespaces.selection in
# rms.yaml). The old per-upstream ports no longer exist.
#
# WHAT THIS COSTS
# ---------------
# With no namespace in the path, the client does not say which upstream it means.
# For Docker Hub that is harmless: only the docker.io namespace has
# `library/alpine`, so the unqualified request picks docker.io and the pull
# works. For any other upstream it is not: an image that only lives on ghcr.io
# asked for unqualified may be matched by a different namespace, or by none —
# in which case rms answers 404 NAME_UNKNOWN. Two ways to be exact:
#
#   1. Put the namespace in the image name and use the primary endpoint:
#         192.168.188.101:5000/ghcr.io/owner/app:tag
#      (works with docker, containerd, podman — no mirror configuration at all);
#   2. Pin one upstream with hosts.toml + override_path (bottom of this file).

mirrors:
  docker.io:
    endpoint:
      - "http://192.168.188.101:5000"

  # No entry for ghcr.io/gcr.io/quay.io/registry.k8s.io: a mirror entry would
  # send an unqualified name and leave the choice to rms. Use the namespace
  # prefix in the image name instead (see above).

configs:
  # Credentials are only needed for private (local) namespaces. Public cache
  # namespaces are readable anonymously, so omit the block entirely if you only
  # mirror.
  "192.168.188.101:5000":
    auth:
      username: alice
      password: alicepw
    tls:
      # rms serves plain HTTP; TLS is terminated by the reverse proxy in front
      # of the primary endpoint.
      insecure_skip_verify: true

# ---------------------------------------------------------------------------
# hosts.toml variant, if you prefer the modern layout
# ---------------------------------------------------------------------------
#
# /etc/containerd/certs.d/docker.io/hosts.toml
#
#   server = "https://registry-1.docker.io"
#
#   [host."http://192.168.188.101:5000"]
#     capabilities = ["pull", "resolve"]
#     skip_verify = true
#
# `override_path = true` additionally lets the endpoint be used with a path
# prefix, because it tells containerd to treat the whole path as the API root.
# That is the only way to pin one upstream in the client, and it works for every
# upstream, not just Docker Hub:
#
#   # /etc/containerd/certs.d/ghcr.io/hosts.toml
#   server = "https://ghcr.io"
#
#   [host."http://192.168.188.101:5000/v2/ghcr.io"]
#     capabilities = ["pull", "resolve"]
#     override_path = true
#     skip_verify = true
